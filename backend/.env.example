# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database (required — validation fails fast if unset)
MONGODB_URI=mongodb://localhost:27017/okaform

# Auth
JWT_SECRET=your-access-token-secret-change-me
JWT_REFRESH_SECRET=your-refresh-token-secret-change-me
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Rate limiting (requests per TTL window; global default)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
BACKEND_KEYPAIR=[1,2,3,...,64] # JSON array of secret key bytes
AUTHORITY_KEYPAIR=[1,2,3,...,64] # on-chain authority::ID keypair (must match the deployed program's authority)

# Protocol fee (in basis points, 0 = disabled, 500 = 5%)
PROTOCOL_FEE_BPS=0
PROTOCOL_FEE_WALLET=<your_authority_wallet_pubkey> # wallet that receives the protocol fee
