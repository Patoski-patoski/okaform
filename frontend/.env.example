# Backend API base URL (dev default; set to your deployed API in production)
VITE_API_URL=http://localhost:3000

# Solana cluster endpoint. Leave empty to fall back to the official RPC for VITE_SOLANA_NETWORK.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana cluster: devnet | testnet | mainnet-beta
VITE_SOLANA_NETWORK=devnet

